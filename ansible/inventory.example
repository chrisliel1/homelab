---
plugin: proxmox.proxmox.proxmox
url: "https://{{ lookup('env', 'PROXMOX_HOST') }}:8006"
user: "{{ lookup('env', 'PROXMOX_API_USER') }}"
token_id: "{{ lookup('env', 'PROXMOX_TOKEN_ID') }}"
token_secret: "{{ lookup('env', 'PROXMOX_TOKEN_SECRET') }}"
validate_certs: false
want_facts: true

compose:
  ansible_host: proxmox_net0.ip | regex_replace('/.*', '')

keyed_groups:
  - prefix: tipo
    key: type
  - prefix: nodo
    key: node
  - prefix: tag
    key: tags
